# CA System Docker 部署环境变量配置
# 复制此文件为 .env 并根据需要修改

# ============================================
# MySQL 数据库配置
# ============================================
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=ca_system
MYSQL_USER=ca_user
MYSQL_PASSWORD=ca_pass123
MYSQL_PORT=3306

# ============================================
# 服务端口配置
# ============================================
BACKEND_PORT=8088
FRONTEND_PORT=80

# ============================================
# 邮件服务配置（可选）
# ============================================
MAIL_ENABLED=false
MAIL_FROM=noreply@casystem.com
MAIL_SMTP_HOST=smtp.qq.com
MAIL_SMTP_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ============================================
# 证书到期提醒配置
# ============================================
REMINDER_DAYS=30,15,7
